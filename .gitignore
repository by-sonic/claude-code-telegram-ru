# Состояние работы моста: offset обновлений, id сессий на каждый чат,
# переопределения модели. Персональное и никому больше не нужное.
bridge/state.json
bridge/state.json.tmp

# Логи. Содержат id чатов и текст задач. .prev — лог прошлого запуска.
*.log
*.log.err
*.prev

# Токен и allowlist живут вне репозитория — в ~/.claude/channels/telegram/ —
# но перечислим на случай, если кто-то положит их рядом.
.env
access.json

node_modules/
